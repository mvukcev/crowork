APP_NAME=CroWork
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://example.com

# Coming Soon / Private Preview mode
# Source of truth for coming soon mode:
# - env: COMING_SOON_ENABLED in this file controls coming soon mode.
# - admin: admin setting `coming_soon_enabled` controls coming soon mode.
# Defaults to env for production safety.
COMING_SOON_MODE=env
# Used when COMING_SOON_MODE=env.
COMING_SOON_ENABLED=false

# Demo preview credentials (session-based preview access only, not a real user account).
COMING_SOON_DEMO_USERNAME=
COMING_SOON_DEMO_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Comma-separated list of trusted reverse proxy IPs/CIDRs.
# Example: TRUSTED_PROXIES=10.0.0.1,10.0.0.0/24
TRUSTED_PROXIES=

# Comma-separated regex host patterns allowed in non-local environments.
# Example: TRUSTED_HOSTS=^(.+\.)?example\.com$
TRUSTED_HOSTS=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

AZURE_TRANSLATOR_ENABLED=false
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Sentry (error monitoring)
# Place your Sentry DSN in SENTRY_LARAVEL_DSN when enabling Sentry integration.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=${APP_ENV}

VITE_APP_NAME="${APP_NAME}"
