APP_NAME=CroWork
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Shared-hosting install helper (/_install-crowork)
# Keep this disabled in normal operation.
# Enable only for first production deploy, then disable immediately after install.
INSTALL_HELPER_ENABLED=false
INSTALL_TOKEN=

# Shared-hosting update helper (/_update-crowork)
# Keep this disabled in normal operation.
# Enable only during controlled deployment updates,
# then disable immediately after update completes.
UPDATE_HELPER_ENABLED=false

# Set long random tokens when enabling helpers.
UPDATE_TOKEN=

# Coming Soon / Private Preview mode
# Set to true in production to protect public pages behind a Coming Soon screen.
COMING_SOON_ENABLED=false

# Demo preview credentials (session-based preview access only, not a real user account).
COMING_SOON_DEMO_USERNAME=demo
COMING_SOON_DEMO_PASSWORD=demo123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Sentry (error monitoring)
# Place your Sentry DSN in SENTRY_LARAVEL_DSN when enabling Sentry integration.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=${APP_ENV}

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
